---
import { site } from '../../../site.config';

interface Props {
  /** "~/experience/transact-comply" */
  crumb: string;
}

const { crumb } = Astro.props;
---

<header class="topbar no-print flex items-center gap-3 px-3 sm:px-6">
  <button
    type="button"
    data-side-open
    aria-label="Open navigation"
    aria-controls="sidebar"
    class="when-side-hidden grid size-11 flex-none place-items-center rounded-[10px] bg-transparent text-text"
  >
    <span aria-hidden="true" class="flex w-[18px] flex-col gap-1">
      <span class="h-[1.5px] bg-current"></span>
      <span class="h-[1.5px] bg-current"></span>
      <span class="h-[1.5px] w-3 bg-current"></span>
    </span>
  </button>
  <a href="/" class="when-side-hidden display text-[19px] leading-none tracking-[-0.02em] whitespace-nowrap text-text no-underline">
    {site.name}
  </a>
  <span data-crumb data-crumb-page={crumb} class="min-w-0 flex-1 truncate font-mono text-[11.5px] leading-none font-medium tracking-[0.02em] text-muted max-sm:invisible">
    {crumb}
  </span>
  <a href="/resume/" target="_blank" rel="noopener" data-track="resume_opened" class="pill max-sm:hidden">Résumé ↗</a>
  <button
    type="button"
    data-theme-toggle
    aria-label="Toggle light and dark theme"
    class="grid size-10 flex-none place-items-center rounded-full border border-border bg-transparent text-text transition-opacity duration-fast hover:opacity-70"
  >
    <span aria-hidden="true" class="box-border block size-[15px] rounded-full border-[1.5px] border-current bg-[linear-gradient(90deg,currentColor_50%,transparent_50%)]"></span>
  </button>
</header>
