---
// Conversation view. Hidden until a free-text question is asked; it then replaces the page
// content in place (history entry #conversation) and lives in sessionStorage for the visit.
import { site } from '../../../site.config';
---

<section data-chat hidden aria-label="Conversation" class="page">
  <div
    data-chat-log
    aria-live="polite"
    class="mx-auto box-border flex w-full max-w-[760px] flex-col gap-7 px-[clamp(18px,4cqi,40px)] pt-[clamp(24px,5cqi,48px)] pb-8"
  >
  </div>
</section>

<template id="tpl-chat-user">
  <div class="flex flex-col">
    <div data-text class="max-w-[82%] self-end rounded-[18px_18px_4px_18px] bg-surface px-4 py-3 text-[16px] leading-[1.55]"></div>
  </div>
</template>

<template id="tpl-chat-bot">
  <div class="flex max-w-[640px] flex-col gap-3">
    <span class="flex items-center gap-2 font-mono text-[11px] leading-none font-medium tracking-[0.08em] text-muted uppercase">
      <span aria-hidden="true" class="size-2 rounded-[2px] bg-accent"></span>{site.handle}
    </span>
    <p data-text class="m-0 text-[16.5px] leading-[1.65] text-pretty"></p>
    <div data-chips class="flex flex-wrap gap-2"></div>
    <span data-footnote hidden class="font-mono text-[10.5px] leading-[1.4] font-medium tracking-[0.08em] text-muted uppercase">
      {site.ask.footnote}
    </span>
  </div>
</template>

<template id="tpl-chat-chip">
  <a class="cmd-chip px-[13px] py-[9px]"><span></span><span></span></a>
</template>
