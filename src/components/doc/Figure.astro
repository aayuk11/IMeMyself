---
// Reader figure. With children (a diagram or an image) it frames them; without, it draws the
// design's hatched placeholder until an Excalidraw export exists.
interface Props {
  caption?: string;
  /** Placeholder label, e.g. "Chart · failures by gate". */
  label?: string;
  /** Placeholder height in px. */
  height?: number;
}

const { caption, label = 'Figure', height = 240 } = Astro.props;
const hasContent = Astro.slots.has('default');
---

<figure class="not-prose my-2 flex flex-col gap-2.5">
  {
    hasContent ? (
      <slot />
    ) : (
      <div
        role="img"
        aria-label={`Placeholder: ${label}`}
        class="hatch box-border flex items-end rounded-[14px] border border-border p-3.5"
        style={`height:${height}px`}
      >
        <span class="eyebrow rounded bg-card px-2 py-[5px] text-[10.5px] leading-[1.3] text-muted">{label}</span>
      </div>
    )
  }
  {caption && <figcaption class="font-mono text-[11.5px] leading-normal font-medium text-muted">{caption}</figcaption>}
</figure>
