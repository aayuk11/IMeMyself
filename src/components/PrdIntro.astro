---
// PRD-tear intro. Plays once per session on Home (the inline head script sets
// <html data-intro="play">), and on any page via /intro. Timeline: src/scripts/intro.ts.
// Hidden unless playing; never blocks input once finished.
import type { IntroVariant } from '../../site.config';
import PrdSheet from './PrdSheet.astro';

interface Props {
  variant: Exclude<IntroVariant, 'off'>;
}

const { variant } = Astro.props;

// Shred: 12 strips, falling in this order.
const ORDER = [3, 7, 1, 9, 5, 0, 11, 4, 8, 2, 10, 6];
const strips = ORDER.map((o, i) => ({
  left: `${(i * 100) / 12}%`,
  inner: `${-i * 100}%`,
  rot: `${(i % 2 ? 1 : -1) * (1 + (o % 4))}deg`,
  delay: `${o * 45}ms`,
}));
---

<div class="prd-intro" data-variant={variant} data-phase="idle" aria-hidden="true">
  {
    variant === 'rip' && (
      <>
        <div class="half half--l">
          <div class="fiber fiber--l" />
          <div class="paper paper--l">
            <PrdSheet />
          </div>
        </div>
        <div class="half half--r">
          <div class="fiber fiber--r" />
          <div class="paper paper--r">
            <PrdSheet />
          </div>
        </div>
      </>
    )
  }
  {
    variant === 'peel' && (
      <div class="peel">
        <div class="peel-sheet">
          <div class="paper paper--peel">
            <PrdSheet inset="peel" />
          </div>
        </div>
        <div class="stub" />
        <div class="holes">
          <span />
          <span />
          <span />
        </div>
      </div>
    )
  }
  {
    variant === 'shred' &&
      strips.map((s) => (
        <div class="strip" style={`left:${s.left};--rot:${s.rot};--delay:${s.delay}`}>
          <div class="strip-inner" style={`left:${s.inner}`}>
            <PrdSheet simple />
          </div>
        </div>
      ))
  }
  <div class="hint"><span>Click to skip</span></div>
</div>

<style>
  .prd-intro {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    overflow: hidden;
    container-type: size;
    cursor: pointer;
  }
  :global(html[data-intro='play']) .prd-intro {
    display: block;
    /* Failsafe: if the script never runs, get out of the way. */
    animation: prd-failsafe 0s linear 6s forwards;
  }
  .prd-intro[data-phase='done'] {
    visibility: hidden;
    pointer-events: none;
  }
  @keyframes prd-failsafe {
    to { visibility: hidden; }
  }

  .paper { position: absolute; inset: 0; background: var(--prd-paper); }

  /* ---------- rip ---------- */
  .half {
    position: absolute;
    inset: 0;
    filter: drop-shadow(0 14px 30px var(--prd-shadow));
  }
  .fiber {
    position: absolute;
    inset: 0;
    background: var(--prd-fiber);
    opacity: 0;
  }
  .prd-intro:not([data-phase='idle']) .fiber { opacity: 1; }

  .fiber--l { clip-path: polygon(0 0, 50.6% 0%, 52.2% 4%, 49.8% 8%, 51.5% 12%, 49.3% 16%, 51.9% 20%, 50.2% 24%, 52.6% 28%, 50.9% 32%, 49.5% 36%, 51.7% 40%, 50% 44%, 52.4% 48%, 50.7% 52%, 49.2% 56%, 51.4% 60%, 52.8% 64%, 50.1% 68%, 51.6% 72%, 49.4% 76%, 51.2% 80%, 52.7% 84%, 49.9% 88%, 51.5% 92%, 49.5% 96%, 51% 100%, 0 100%); }
  .paper--l { clip-path: polygon(0 0, 50% 0%, 51.6% 4%, 49.2% 8%, 50.9% 12%, 48.7% 16%, 51.3% 20%, 49.6% 24%, 52% 28%, 50.3% 32%, 48.9% 36%, 51.1% 40%, 49.4% 44%, 51.8% 48%, 50.1% 52%, 48.6% 56%, 50.8% 60%, 52.2% 64%, 49.5% 68%, 51% 72%, 48.8% 76%, 50.6% 80%, 52.1% 84%, 49.3% 88%, 50.9% 92%, 48.9% 96%, 50.4% 100%, 0 100%); }
  .fiber--r { clip-path: polygon(100% 0, 49.4% 0%, 51% 4%, 48.6% 8%, 50.3% 12%, 48.1% 16%, 50.7% 20%, 49% 24%, 51.4% 28%, 49.7% 32%, 48.3% 36%, 50.5% 40%, 48.8% 44%, 51.2% 48%, 49.5% 52%, 48% 56%, 50.2% 60%, 51.6% 64%, 48.9% 68%, 50.4% 72%, 48.2% 76%, 50% 80%, 51.5% 84%, 48.7% 88%, 50.3% 92%, 48.3% 96%, 49.8% 100%, 100% 100%); }
  .paper--r { clip-path: polygon(100% 0, 50% 0%, 51.6% 4%, 49.2% 8%, 50.9% 12%, 48.7% 16%, 51.3% 20%, 49.6% 24%, 52% 28%, 50.3% 32%, 48.9% 36%, 51.1% 40%, 49.4% 44%, 51.8% 48%, 50.1% 52%, 48.6% 56%, 50.8% 60%, 52.2% 64%, 49.5% 68%, 51% 72%, 48.8% 76%, 50.6% 80%, 52.1% 84%, 49.3% 88%, 50.9% 92%, 48.9% 96%, 50.4% 100%, 100% 100%); }

  .prd-intro[data-phase='tension'] .half { transition: transform 220ms ease-out; }
  .prd-intro[data-phase='out'] .half { transition: transform 1100ms cubic-bezier(0.6, 0.02, 0.3, 1); }
  .prd-intro[data-phase='tension'] .half--l { transform: translateX(-0.7%) rotate(-0.5deg); }
  .prd-intro[data-phase='tension'] .half--r { transform: translateX(0.7%) rotate(0.5deg); }
  .prd-intro[data-phase='out'] .half--l { transform: translate(-64%, 7%) rotate(-9deg); }
  .prd-intro[data-phase='out'] .half--r { transform: translate(64%, 5%) rotate(8deg); }

  /* ---------- peel ---------- */
  .peel { position: absolute; inset: 0; perspective: 1800px; }
  .peel-sheet {
    position: absolute;
    inset: 0;
    transform-origin: 50% 0;
    filter: drop-shadow(0 18px 36px var(--prd-shadow));
  }
  .paper--peel { clip-path: polygon(0 4%, 5% 4.6%, 10% 3.6%, 15% 4.4%, 20% 3.4%, 25% 4.8%, 30% 3.9%, 35% 4.5%, 40% 3.5%, 45% 4.2%, 50% 3.7%, 55% 4.9%, 60% 3.8%, 65% 4.3%, 70% 3.3%, 75% 4.6%, 80% 4%, 85% 3.6%, 90% 4.7%, 95% 3.9%, 100% 4.2%, 100% 100%, 0 100%); }
  .stub {
    position: absolute;
    inset: 0;
    background: var(--prd-paper);
    clip-path: polygon(0 0, 100% 0, 100% 4.2%, 95% 3.9%, 90% 4.7%, 85% 3.6%, 80% 4%, 75% 4.6%, 70% 3.3%, 65% 4.3%, 60% 3.8%, 55% 4.9%, 50% 3.7%, 45% 4.2%, 40% 3.5%, 35% 4.5%, 30% 3.9%, 25% 4.8%, 20% 3.4%, 15% 4.4%, 10% 3.6%, 5% 4.6%, 0 4%);
    transition: opacity 450ms ease 450ms;
  }
  .holes {
    position: absolute;
    left: 0;
    right: 0;
    top: 1.6cqh;
    display: flex;
    justify-content: center;
    gap: 5cqw;
    transition: opacity 450ms ease 450ms;
  }
  .holes span { width: 1.2cqw; height: 1.2cqw; border-radius: 50%; background: var(--prd-rule); }
  .prd-intro[data-phase='tension'] .peel-sheet { transition: transform 220ms ease-out; transform: rotateX(12deg); }
  .prd-intro[data-phase='out'] .peel-sheet {
    transition: transform 1100ms cubic-bezier(0.6, 0.02, 0.3, 1);
    transform: translateY(-120%) rotateX(40deg) rotate(-3deg);
  }
  .prd-intro[data-phase='out'] .stub,
  .prd-intro[data-phase='out'] .holes { opacity: 0; }

  /* ---------- shred ---------- */
  .strip {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 8.3334%;
    overflow: hidden;
    background: var(--prd-paper);
    box-shadow: 0 0 0 0.5px var(--prd-rule);
  }
  .strip-inner { position: absolute; top: 0; bottom: 0; width: 1200%; }
  .prd-intro[data-phase='tension'] .strip { transition: transform 200ms ease-out; transform: scaleX(0.93); }
  .prd-intro[data-phase='out'] .strip {
    transition: transform 900ms cubic-bezier(0.55, 0, 0.8, 0.25) var(--delay);
    transform: translateY(120%) rotate(var(--rot));
  }

  /* ---------- hint ---------- */
  .hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 3cqh;
    display: flex;
    justify-content: center;
    pointer-events: none;
    transition: opacity 200ms ease;
  }
  .hint span {
    font: 500 max(9px, 0.85cqw) / 1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--prd-meta);
    background: var(--prd-paper);
    padding: 0.8cqh 1cqw;
  }
  .prd-intro:not([data-phase='idle']) .hint { opacity: 0; }
</style>
