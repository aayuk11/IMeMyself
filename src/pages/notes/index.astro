---
import { site } from '../../../site.config';
import Base from '../../layouts/Base.astro';
import { getFeed, type FeedItem, type FeedKind } from '../../lib/content';
import { formatShort, isoDate } from '../../lib/format';

const feed = await getFeed();

const KIND_LABEL: Record<FeedKind, string> = { learned: 'Learned', built: 'Built', wrote: 'Wrote' };
const filters = [
  { id: 'all', label: 'All', count: feed.length },
  ...(['learned', 'built', 'wrote'] as const).map((k) => ({ id: k, label: KIND_LABEL[k], count: feed.filter((f) => f.kind === k).length })),
];

const years = new Map<number, FeedItem[]>();
for (const item of feed) {
  const y = item.date.getUTCFullYear();
  years.set(y, [...(years.get(y) ?? []), item]);
}
const entries = (n: number) => `${n} ${n === 1 ? 'entry' : 'entries'}`;

const timeClass = 'flex-[0_0_64px] font-mono text-[11.5px] leading-[1.4] font-medium tracking-[0.06em] text-muted uppercase';
const kindClass = 'inline-flex flex-[0_0_84px] items-center gap-[7px] font-mono text-[10.5px] leading-[1.4] font-medium tracking-[0.08em] text-ink uppercase';
---

<Base title={site.notesName} description="Short notes on what Aayush is learning, logs of what he’s building, and essays." crumb="~/notes" current="notes">
  <section class="mx-auto box-border flex w-full max-w-[900px] flex-col gap-[30px] px-[clamp(18px,4cqi,40px)] pt-[clamp(20px,4cqi,40px)] pb-12">
    <span class="user-bubble" aria-hidden="true">/notes</span>
    <header class="flex flex-col gap-3.5">
      <h1 class="display m-0 text-[clamp(36px,5.6cqi,52px)] leading-[1.05] tracking-[-0.03em]">{site.notesName}</h1>
      <p class="eyebrow m-0 flex flex-wrap items-center gap-x-3.5 gap-y-2 text-[12px] text-ink">
        <span>Learn</span><span aria-hidden="true" class="text-muted">→</span><span>Build</span><span aria-hidden="true" class="text-muted">→</span><span>Write</span>
      </p>
      <p class="m-0 max-w-[620px] text-[17px] leading-[1.6] text-pretty text-muted">
        Short notes on what I’m learning, logs of what I’m building, and essays once it’s worth writing up.{' '}
        {site.socials.medium ? 'Medium posts are merged in.' : ''}
      </p>
    </header>

    {
      feed.length > 0 ? (
        <>
          <div data-filters hidden role="group" aria-label="Filter by kind" class="flex flex-wrap gap-1.5">
            {filters.map((f) => (
              <button
                type="button"
                data-filter={f.id}
                aria-pressed={f.id === 'all' ? 'true' : 'false'}
                class="eyebrow inline-flex items-center gap-2 rounded-full border border-border bg-transparent px-3.5 py-2 leading-none text-text transition-opacity duration-fast hover:opacity-75 aria-pressed:border-text aria-pressed:bg-text aria-pressed:text-bg"
              >
                <span>{f.label}</span>
                <span class="opacity-60">{f.count}</span>
              </button>
            ))}
          </div>

          <div class="flex flex-col gap-9">
            {[...years].map(([year, items]) => (
              <section data-year-group class="flex flex-col" aria-label={String(year)}>
                <div class="flex items-baseline justify-between gap-3 border-b border-text pb-2.5">
                  <h2 class="display m-0 text-[26px] leading-none tracking-[-0.02em]">{year}</h2>
                  <span data-year-count class="eyebrow leading-none text-muted">
                    {entries(items.length)}
                  </span>
                </div>
                {items.map((n) =>
                  n.kind === 'wrote' && n.href ? (
                    <a
                      id={n.id}
                      href={n.href}
                      data-snap
                      data-kind={n.kind}
                      target={n.external ? '_blank' : undefined}
                      rel={n.external ? 'noopener' : undefined}
                      class="flex flex-wrap items-baseline gap-x-6 gap-y-1.5 border-b border-border py-[22px] text-text no-underline transition-opacity duration-fast hover:opacity-70"
                    >
                      <time datetime={isoDate(n.date)} class={timeClass}>
                        {formatShort(n.date)}
                      </time>
                      <span class={kindClass}>
                        <span aria-hidden="true" class="kind-dot" data-dot={n.kind} />
                        {KIND_LABEL[n.kind]}
                      </span>
                      <span class="flex min-w-0 flex-[1_1_300px] flex-col gap-1.5">
                        <span class="display text-[clamp(22px,3cqi,26px)] leading-[1.2] tracking-[-0.02em]">{n.title}</span>
                        <span class="text-[15px] leading-[1.55] text-pretty text-muted">{n.dek}</span>
                      </span>
                      <span class="eyebrow flex flex-none gap-3 text-muted">
                        {n.readTime && <span>{n.readTime} min</span>}
                        {n.medium && <span class="text-text">Medium ↗</span>}
                        {n.draft && <span class="text-text">Draft</span>}
                      </span>
                    </a>
                  ) : (
                    <div id={n.id} data-snap data-kind={n.kind} class="flex flex-wrap items-baseline gap-x-6 gap-y-1.5 border-b border-border py-[18px]">
                      <time datetime={isoDate(n.date)} class={timeClass}>
                        {formatShort(n.date)}
                      </time>
                      <span class={kindClass}>
                        <span aria-hidden="true" class="kind-dot" data-dot={n.kind} />
                        {KIND_LABEL[n.kind]}
                      </span>
                      <span class="flex min-w-0 flex-[1_1_300px] flex-col gap-1">
                        <span class="text-[16.5px] leading-[1.4] font-semibold">{n.title}</span>
                        <span class="text-[15px] leading-[1.55] text-pretty text-muted">{n.dek}</span>
                      </span>
                      {n.url && (
                        <a
                          href={n.url}
                          target="_blank"
                          rel="noopener"
                          class="eyebrow flex-none text-text no-underline transition-opacity duration-fast hover:opacity-70"
                        >
                          Open ↗
                        </a>
                      )}
                      {n.draft && <span class="eyebrow flex-none text-muted">Draft</span>}
                    </div>
                  ),
                )}
              </section>
            ))}
          </div>
        </>
      ) : (
        <p class="m-0 border-t border-text pt-6 text-[16px] leading-[1.6] text-muted">
          Nothing published yet. The first notes are in draft; the RSS feed picks them up when they land.
        </p>
      )
    }
  </section>
</Base>
