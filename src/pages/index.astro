---
import { site } from '../../site.config';
import Base from '../layouts/Base.astro';
import { getFeed } from '../lib/content';
import { formatDate } from '../lib/format';

const latest = (await getFeed()).find((item) => item.kind === 'wrote');

const links = [
  { label: 'Email', href: `mailto:${site.email}`, external: false },
  { label: 'LinkedIn ↗', href: site.socials.linkedin, external: true },
  { label: 'GitHub ↗', href: site.socials.github, external: true },
  ...(site.socials.medium ? [{ label: 'Medium ↗', href: `https://medium.com/@${site.socials.medium}`, external: true }] : []),
];

const quick = [
  { cmd: '/experience', label: 'Experience', href: '/experience/' },
  { cmd: '/notes', label: site.notesName, href: '/notes/' },
  { cmd: '/lab', label: 'Lab', href: '/lab/' },
  { cmd: '/resume', label: 'Résumé ↗', href: '/resume/', newTab: true },
];

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: Astro.site?.toString(),
  email: `mailto:${site.email}`,
  description: site.description,
  jobTitle: site.experience[0]?.role,
  worksFor: { '@type': 'Organization', name: site.experience[0]?.org },
  alumniOf: { '@type': 'CollegeOrUniversity', name: site.education.schoolFull },
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressCountry: 'IN' },
  sameAs: [site.socials.linkedin, site.socials.github],
};
---

<Base crumb="~/" current="home" intro jsonLd={person}>
  <section class="mx-auto box-border flex w-full max-w-[780px] flex-1 flex-col justify-center gap-7 px-[clamp(20px,4cqi,40px)] pt-[clamp(28px,6cqi,64px)] pb-7">
    <p class="eyebrow m-0 flex items-center gap-2.5 text-[11.5px] text-muted">
      <span aria-hidden="true" class="size-2 flex-none rounded-full bg-accent shadow-[0_0_0_3px_var(--highlight)]"></span>
      <span data-greet data-tz={site.timezone} data-city={site.city}>Hello from {site.city}</span>
    </p>
    <h1 class="display m-0 text-[clamp(40px,7cqi,64px)] leading-[1.04] tracking-[-0.03em] text-balance">
      {site.name}<span class="block text-muted">{site.headline}</span>
    </h1>
    <p class="m-0 max-w-[580px] text-[clamp(16px,2.2cqi,18px)] leading-[1.65] text-pretty">{site.bio}</p>
    <div class="flex flex-wrap items-center gap-x-[22px] gap-y-2.5">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="hl-link text-[15px] leading-normal font-medium"
            target={l.external ? '_blank' : undefined}
            rel={l.external ? 'me noopener' : undefined}
          >
            {l.label}
          </a>
        ))
      }
      {
        site.building && (
          <a href={site.building.href} target="_blank" rel="noopener" class="pill px-3 py-[7px]">
            <span class="text-muted">Building</span>
            {site.building.name} ↗
          </a>
        )
      }
    </div>
    <div class="mt-3 flex flex-col gap-3">
      <span class="eyebrow text-muted">Start with a command</span>
      <div class="flex flex-wrap gap-2">
        {
          quick.map((q) => (
            <a href={q.href} class="cmd-chip" target={q.newTab ? '_blank' : undefined} rel={q.newTab ? 'noopener' : undefined}>
              <span>{q.cmd}</span>
              <span>{q.label}</span>
            </a>
          ))
        }
      </div>
    </div>
    {
      latest?.href && (
        <a
          href={latest.href}
          target={latest.external ? '_blank' : undefined}
          rel={latest.external ? 'noopener' : undefined}
          class="flex flex-wrap items-baseline gap-x-3.5 gap-y-1.5 border-t border-border pt-5 text-text no-underline transition-opacity duration-fast hover:opacity-70"
        >
          <span class="eyebrow text-ink">Latest essay · {formatDate(latest.date)}</span>
          <span class="display text-[19px] leading-[1.3] tracking-[-0.01em]">{latest.title} →</span>
        </a>
      )
    }
  </section>
</Base>
