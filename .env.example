# Copy to .env for local use with `npx netlify-cli dev`. On Netlify, set these under
# Site configuration → Environment variables (Production and Deploy Previews). Never commit real keys.

# AI answers in the command box (netlify/functions/ask). Without a provider the box still works:
# questions get "The model's resting" and links to the right pages.
#   groq      free tier, recommended: https://console.groq.com (turn on Zero Data Retention)
#   openai    any OpenAI-compatible API (also set AI_BASE_URL and AI_MODEL)
#   anthropic Claude (paid)
#   mock      canned answers for local testing, no key, refused in production
AI_PROVIDER=mock
AI_API_KEY=
# Optional for groq (default openai/gpt-oss-120b) and anthropic (default claude-opus-5-5).
AI_MODEL=
# Optional for groq (default https://api.groq.com/openai/v1), required for openai.
AI_BASE_URL=
# Model calls per day across all visitors. 0 = no cap. Protects the free tier and Netlify credits.
AI_DAILY_CAP=80
# Stop Netlify's AI Gateway injecting its own keys (it bills calls to your Netlify credits).
AI_GATEWAY_INJECTION=false

# Optional analytics. Nothing loads when the key is empty.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
