# Copy to .env for local use with `netlify dev`. On Netlify, set these under
# Site configuration → Environment variables. Never commit real keys.

# Command box Q&A (netlify/functions/ask.mts). Without it the box still navigates;
# questions get a polite "email me" reply.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# Optional analytics. Nothing loads when the key is empty.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
